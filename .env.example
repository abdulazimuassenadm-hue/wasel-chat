# ==========================================================================
# إعدادات Wasel Chat
# انسخ هذا الملف إلى ".env.local" ثم املأ القيم من مشروع Supabase الخاص بك.
# مهم جداً: لا ترفع ملف .env.local إلى مستودع عام، ولا تضع service_role key هنا.
# ==========================================================================

# رابط مشروع Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (Settings → API → Project API keys → anon / public)
# هذا المفتاح آمن للاستخدام في المتصفح لأن الحماية الحقيقية تأتي من سياسات RLS.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --------------------------------------------------------------------------
# اختياري: خوادم WebRTC للمكالمات
# STUN العام يعمل في معظم الشبكات المنزلية.
# شبكات الشركات/الجوال قد تتطلب خادم TURN، بدونه قد تفشل بعض المكالمات.
# يمكن إضافة بيانات TURN من مزوّد مثل Twilio / Metered / Cloudflare Calls.
# --------------------------------------------------------------------------
VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=username
# VITE_TURN_CREDENTIAL=password

# --------------------------------------------------------------------------
# اختياري: Web Push Notifications
# أنشئ مفتاح VAPID خاصاً بك (npx web-push generate-vapid-keys) وضعه هنا،
# والمفتاح الخاص يوضع في دالة Edge على Supabase (Supabase → Edge Functions).
# --------------------------------------------------------------------------
# VITE_VAPID_PUBLIC_KEY=
