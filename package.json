{
  "name": "wasel-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wasel Chat | واصل شات - منصة مراسلة فورية حقيقية مبنية على Supabase و WebRTC",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:copy": "npm run build && cap copy",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "verify:sw": "node scripts/verify-sw.mjs",
    "verify:turn": "node scripts/verify-turn.mjs",
    "verify": "npm run typecheck && npm run verify:sw && npm run verify:turn"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
