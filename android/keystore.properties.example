# ---------------------------------------------------------------------------
# إعداد توقيع نسخة الإصدار (Release) لتطبيق «واصل شات»
# ---------------------------------------------------------------------------
# الاستخدام:
#   1) انسخ هذا الملف إلى الملف المجاور باسم:  keystore.properties
#      (ملف keystore.properties مُستثنى من git ولا يُرفع أبداً)
#   2) أنشئ مفتاح التوقيع مرة واحدة فقط (يتطلب JDK 21 — keytool):
#
#      keytool -genkeypair -v ^
#        -keystore wasel-release.jks ^
#        -alias wasel ^
#        -keyalg RSA -keysize 2048 -validity 10000
#
#      (المسار الناتج هنا: android/wasel-release.jks — أي نسبي إلى مجلد android/)
#   3) املأ القيم أدناه، ثم ابنِ حزمة Google Play:
#
#      cd android
#      ./gradlew bundleRelease
#
#      الناتج: android/app/build/outputs/bundle/release/app-release.aab
#
# تحذير مهم: احتفظ بملف المفتاح وكلمات المرور في مكان آمن.
# فقدان مفتاح التوقيع يعني عدم القدرة على إصدار تحديثات للتطبيق على Google Play.
# (يُنصح بتفعيل «Play App Signing» في Play Console لتتولّى Google حفظ مفتاح التوقيع.)
# ---------------------------------------------------------------------------

# مسار ملف المفتاح — نسبي إلى مجلد android/
storeFile=wasel-release.jks
storePassword=CHANGE_ME
keyAlias=wasel
keyPassword=CHANGE_ME
